#!/bin/bash
#PBS -N lightgbm_v2
#PBS -l walltime=06:00:00
#PBS -l mem=16gb
#PBS -l ncpus=4
#PBS -j oe
#PBS -o logs/lightgbm_v2.log

echo "Job started: $(date)"
cd $PBS_O_WORKDIR
module add mambaforge
source /software/mambaforge/22.9.0-3/etc/profile.d/conda.sh
conda activate /storage/praha1/home/kalaluka_1550/.conda/envs/pvforecast
python notebooks/train_lightgbm_v2.py
echo "Job finished: $(date)"
