import pandas as pd
from pathlib import Path

DATA = Path("data")

# ENTSO-E series that may have mixed resolution (15-min 2026 + hourly history)
FILES = [
    "entsoe_cz_solar_raw.parquet",
    "entsoe_cz_prices.parquet",
    "entsoe_cz_generation_forecast.parquet",
]

for fname in FILES:
    path = DATA / fname
    if not path.exists():
        print(f"SKIP {fname}: not found")
        continue
    df = pd.read_parquet(path)
    df.index = pd.to_datetime(df.index, utc=True)
    df = df.sort_index()

    # keep only the first column if multiple
    if df.shape[1] > 1:
        df = df.iloc[:, [0]]

    before = len(df)
    med_gap = df.index.to_series().diff().dt.total_seconds().median() / 60

    # resample to hourly mean across the whole span -> uniform hourly
    hourly = df.resample("1h").mean()
    # drop fully-empty hours that can appear from gaps
    hourly = hourly.dropna(how="all")

    hourly.to_parquet(path)
    print(f"{fname}: {before} rows (median gap {med_gap:.0f} min) -> {len(hourly)} hourly rows "
          f"[{hourly.index.min()} -> {hourly.index.max()}]")

print("\nResolution fix complete. All ENTSO-E series now hourly.")
